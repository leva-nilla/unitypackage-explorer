<Window x:Class="UnityPackageExplorer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hx="http://helix-toolkit.org/wpf/SharpDX"
        xmlns:local="clr-namespace:UnityPackageExplorer.App"
        Title="UnityPackage Explorer" Icon="Assets/UnityPackageExplorer.ico" Height="780" Width="1280" MinHeight="560" MinWidth="860" Deactivated="Window_Deactivated"
        Background="#15191F" Foreground="#E5E9EF" WindowStartupLocation="CenterScreen" AllowDrop="True" DragEnter="Window_DragEnter" DragOver="Window_DragOver" Drop="Window_Drop">
    <Window.Resources>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#315B66" />
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF" />
        <HierarchicalDataTemplate DataType="{x:Type local:AssetTreeItemView}" ItemsSource="{Binding Children}">
            <TextBlock Text="{Binding Name}" Foreground="{Binding RelativeSource={RelativeSource AncestorType=TreeViewItem}, Path=Foreground}" TextTrimming="CharacterEllipsis" />
        </HierarchicalDataTemplate>
        <HierarchicalDataTemplate DataType="{x:Type local:PrefabNodeView}" ItemsSource="{Binding Children}">
            <TextBlock Text="{Binding DisplayName}" Foreground="{Binding RelativeSource={RelativeSource AncestorType=TreeViewItem}, Path=Foreground}" TextTrimming="CharacterEllipsis" />
        </HierarchicalDataTemplate>
        <Style TargetType="TreeView">
            <Setter Property="Background" Value="#1C222B" />
            <Setter Property="Foreground" Value="#F0F4F8" />
            <Setter Property="BorderBrush" Value="#303946" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
            <Setter Property="ItemsPanel">
                <Setter.Value><ItemsPanelTemplate><local:PathVirtualizingStackPanel /></ItemsPanelTemplate></Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TreeViewItem">
            <Setter Property="Foreground" Value="#F0F4F8" />
            <Setter Property="Padding" Value="4,3" />
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
            <Setter Property="ItemsPanel">
                <Setter.Value><ItemsPanelTemplate><local:PathVirtualizingStackPanel /></ItemsPanelTemplate></Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <ToggleButton x:Name="Expander" Grid.Column="0" Width="16" Height="22" Content="›" FontSize="18"
                                          Foreground="#9BAABA" Background="Transparent" BorderThickness="0"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Border x:Name="HeaderBorder" Grid.Column="1" Background="Transparent" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                <ContentPresenter x:Name="PART_Header" ContentSource="Header" HorizontalAlignment="Left" VerticalAlignment="Center" />
                            </Border>
                            <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" Grid.Column="1" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="False"><Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/><Setter TargetName="Expander" Property="Content" Value="›"/></Trigger>
                            <Trigger Property="IsExpanded" Value="True"><Setter TargetName="Expander" Property="Content" Value="⌄"/></Trigger>
                            <Trigger Property="HasItems" Value="False"><Setter TargetName="Expander" Property="Visibility" Value="Hidden"/></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="HeaderBorder" Property="Background" Value="#315B66"/><Setter Property="Foreground" Value="#FFFFFF"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#B1BBC6"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#202833" />
            <Setter Property="Foreground" Value="#EEF2F6" />
            <Setter Property="BorderBrush" Value="#394656" />
            <Setter Property="Padding" Value="8,6" />
        </Style>
    </Window.Resources>
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <TextBlock Text="ASSET SHELF" FontSize="13" FontWeight="Bold" Foreground="#75D5C2" VerticalAlignment="Center" Margin="0,0,14,0" />
                <TextBlock x:Name="SourceLabel" Text="ファイルを開いて" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <StackPanel x:Name="CategoryPanel" Orientation="Horizontal" Visibility="Collapsed">
                    <ComboBox x:Name="CategoryPicker" Width="170" Margin="4,0" Padding="8,5" SelectionChanged="CategoryPicker_SelectionChanged" ToolTip="分類先のフォルダー" />
                    <Button x:Name="MoveToCategoryButton" Content="分類先へ移動" Click="MoveToCategoryButton_Click" Margin="4,0" Padding="14,7" IsEnabled="False" ToolTip="内容を確認したあと、選択中の分類フォルダーへZIP本体を移動" />
                </StackPanel>
                <Button x:Name="OpenButton" Content="ファイルを開く" Click="OpenButton_Click" Margin="4,0" Padding="14,7" />
                <Button x:Name="ExtractButton" Content="展開して開く" Click="ExtractButton_Click" Margin="4,0" Padding="14,7" IsEnabled="False" />
            </StackPanel>
        </DockPanel>
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" Grid.Column="0" ToolTip="パスやファイル名で検索" TextChanged="SearchBox_TextChanged" />
            <ComboBox x:Name="KindFilter" Grid.Column="1" Margin="8,0,0,0" SelectionChanged="KindFilter_SelectionChanged" />
        </Grid>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="350"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#1C222B" BorderBrush="#303946" BorderThickness="1" CornerRadius="8" Padding="8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="パッケージの内容" Foreground="#AEB9C6" FontSize="12" Margin="6,3,6,9" />
                    <TreeView x:Name="AssetTree" SelectedItemChanged="AssetTree_SelectedItemChanged" />
                </DockPanel>
            </Border>
            <Border Grid.Column="2" Background="#1C222B" BorderBrush="#303946" BorderThickness="1" CornerRadius="8" Padding="10">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="190"/></Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="2,0,2,8">
                        <TextBlock Text="Prefab候補" Foreground="#AEB9C6" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <CheckBox x:Name="AutoPreviewToggle" Content="開いたとき自動表示" Foreground="#E5E9EF" IsChecked="True" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBlock x:Name="PrefabCandidateCount" Text="Prefab 0件" Foreground="#AEB9C6" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox x:Name="PrefabPicker" MinWidth="0" HorizontalAlignment="Stretch" SelectionChanged="PrefabPicker_SelectionChanged" IsEnabled="False">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis">
                                        <TextBlock.ToolTip><StackPanel><TextBlock Text="{Binding Entry.PathName}"/><TextBlock Text="{Binding Entry.PackageMemberPath}"/></StackPanel></TextBlock.ToolTip>
                                    </TextBlock>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </DockPanel>
                    <Grid Grid.Row="1">
                        <hx:Viewport3DX x:Name="Viewport" Visibility="Collapsed" BackgroundColor="#14191F" ShowCoordinateSystem="True" ShowViewCube="True" ZoomExtentsWhenLoaded="True" Focusable="True" PreviewKeyDown="Viewport_PreviewKeyDown" PreviewKeyUp="Viewport_PreviewKeyUp" PreviewMouseRightButtonDown="Viewport_PreviewMouseRightButtonDown" PreviewMouseRightButtonUp="Viewport_PreviewMouseRightButtonUp" PreviewMouseMove="Viewport_PreviewMouseMove" PreviewMouseWheel="Viewport_PreviewMouseWheel" LostKeyboardFocus="Viewport_LostKeyboardFocus" LostMouseCapture="Viewport_LostMouseCapture">
                            <hx:Viewport3DX.Camera>
                                <hx:PerspectiveCamera Position="3,60,105" LookDirection="-3,-3,-105" UpDirection="0,1,0" FieldOfView="42" />
                            </hx:Viewport3DX.Camera>
                            <hx:AmbientLight3D Color="#FFFFFFFF" />
                            <hx:DirectionalLight3D Direction="-1,-1,-1" Color="#FFFFFFFF" />
                            <hx:SceneNodeGroupModel3D x:Name="SceneModels" />
                        </hx:Viewport3DX>
                        <Border x:Name="ImagePanel" Visibility="Collapsed" Background="#14191F" CornerRadius="6">
                            <Image x:Name="AssetImage" Stretch="Uniform" Margin="8" />
                        </Border>
                        <TextBlock x:Name="ViewerEmpty" Text="FBX・Prefab・画像を選択すると、ここに表示される" Foreground="#718092" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
                        <ProgressBar x:Name="PreviewProgress" Height="3" VerticalAlignment="Top" Margin="12,8" IsIndeterminate="True" Visibility="Collapsed" />
                        <Border x:Name="CameraHelp" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12" Padding="8,5" CornerRadius="4" Background="#B814191F" IsHitTestVisible="False">
                            <TextBlock Text="右ドラッグ 見回し　·　WASD 移動　·　Q/E 上下　·　Shift 加速　·　ホイール ズーム（右ドラッグ中は速度）" FontSize="11" Foreground="#D5DCE5" />
                        </Border>
                    </Grid>
                    <Grid Grid.Row="2" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#202833" CornerRadius="6" Padding="10">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="Prefab の階層" Foreground="#AEB9C6" FontSize="12" Margin="0,0,0,6" />
                                <TreeView x:Name="PrefabTree" />
                            </DockPanel>
                        </Border>
                        <Border Grid.Column="2" Background="#202833" CornerRadius="6" Padding="10">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="情報と読み込み結果" Foreground="#AEB9C6" FontSize="12" Margin="0,0,0,6" />
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <TextBlock x:Name="DetailsText" Text="対応する素材を選択してね" TextWrapping="Wrap" Foreground="#D5DCE5" />
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        <TextBlock Grid.Row="3" x:Name="StatusLabel" Text="Unity は起動せず、パッケージを読み取ります" Foreground="#8F9DAC" FontSize="11" Margin="2,9,0,0" />
    </Grid>
</Window>
