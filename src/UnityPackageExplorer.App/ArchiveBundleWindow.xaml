<Window x:Class="UnityPackageExplorer.App.ArchiveBundleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ZIPをまとめる — UnityPackage Explorer" Icon="Assets/UnityPackageExplorer.ico"
        Width="660" Height="620" MinWidth="560" MinHeight="500"
        Background="#15191F" Foreground="#E5E9EF" FontFamily="Yu Gothic UI, Segoe UI"
        WindowStartupLocation="CenterScreen" Closing="Window_Closing">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#202833"/>
            <Setter Property="Foreground" Value="#EEF2F6"/>
            <Setter Property="BorderBrush" Value="#394656"/>
            <Setter Property="Padding" Value="9,7"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="MinWidth" Value="100"/>
        </Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,20">
            <TextBlock Text="フォルダーにまとめて統合ZIPを作成" FontFamily="Segoe UI Semibold, Yu Gothic UI" FontSize="21"/>
            <TextBlock x:Name="SelectionSummary" Foreground="#AEBBC9" Margin="0,7,0,0"/>
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Label Content="名前の元にするZIP" Target="{Binding ElementName=SourceBox}" Foreground="#E5E9EF" VerticalAlignment="Center" Padding="0"/>
            <ComboBox x:Name="SourceBox" Grid.Column="1" Padding="8,6" DisplayMemberPath="Name" SelectionChanged="SourceBox_SelectionChanged"/>
        </Grid>
        <StackPanel Grid.Row="2" Margin="0,0,0,18">
            <Label Content="フォルダー名" Target="{Binding ElementName=FolderNameBox}" Foreground="#E5E9EF" Padding="0" Margin="0,0,0,6"/>
            <TextBox x:Name="FolderNameBox" FontSize="17" TextChanged="FolderNameBox_TextChanged"/>
        </StackPanel>
        <Border Grid.Row="3" Background="#1C222B" BorderBrush="#303946" BorderThickness="1" Padding="14">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="作成後の構成" Foreground="#AEBBC9" Margin="0,0,0,10"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <TextBlock x:Name="LayoutPreview" FontFamily="Cascadia Mono, Consolas" FontSize="13" LineHeight="23"/>
                </ScrollViewer>
            </DockPanel>
        </Border>
        <StackPanel Grid.Row="4" Margin="0,14,0,16">
            <TextBlock Text="統合ZIPの検証後に元ZIPを移動します。元ZIPの内容は変更しません。" Foreground="#AEBBC9" TextWrapping="Wrap"/>
            <ProgressBar x:Name="Progress" Height="3" Margin="0,12,0,0" IsIndeterminate="True" Visibility="Collapsed"/>
            <TextBlock x:Name="Status" Foreground="#FFCA6E" Margin="0,9,0,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="OpenFolderButton" Content="フォルダーを開く" Click="OpenFolder_Click" Visibility="Collapsed" Margin="0,0,10,0"/>
            <Button x:Name="CancelButton" Content="キャンセル" Click="Cancel_Click" Margin="0,0,10,0"/>
            <Button x:Name="CreateButton" Content="作成してまとめる" Click="Create_Click" IsDefault="True" Background="#315B66" Foreground="White" BorderBrush="#527E87"/>
        </StackPanel>
    </Grid>
</Window>
