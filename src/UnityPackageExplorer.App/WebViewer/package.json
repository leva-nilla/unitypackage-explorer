{
  "name": "unitypackage-explorer-webviewer",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild ./src/main.js --bundle --format=iife --target=es2022 --minify --legal-comments=none --outfile=dist/viewer.js && node build.mjs",
    "test": "node --test test/*.test.js",
    "test:render": "esbuild ./src/main.js --bundle --format=iife --target=es2022 --minify --legal-comments=none --outfile=dist/viewer.js && node build.mjs && node test/render-smoke.mjs"
  },
  "dependencies": {
    "@mochiya/three-liltoon": "0.1.9",
    "three": "0.180.0"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "playwright-core": "1.62.1"
  }
}
